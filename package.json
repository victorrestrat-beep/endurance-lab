{
  "name": "endurance-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Endurance-training analytics in TypeScript: from device files to physiological models.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --run --reporter=verbose",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
